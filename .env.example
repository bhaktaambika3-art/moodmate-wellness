# Flask Application Secret Key (generate a random 32+ character string in production)
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-2026

# Database Connection (Default is local SQLite; in production on Render, PostgreSQL will be provided)
# DATABASE_URL=postgresql://user:password@hostname:5432/moodmate

# Groq API Configuration
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Preferred Model (openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Server Port (optional, default 5000)
PORT=5000
